
<configuration>
	<system.webServer>
		<!-- indicates that the start.js file is a node.js application 
		to be handled by the iisnode module -->

		
		
		<rewrite>
			<rules>
				<rule name="myapp">
					<match url="/*" />
					<action type="Rewrite" url="server.js" />

				</rule>
			</rules>
		</rewrite>
        <handlers>
            <add name="iisnode" path="server.js" verb="*" modules="iisnode" resourceType="Unspecified" />
        </handlers>
        <staticContent>
            <mimeMap fileExtension=".htmls" mimeType="text/html" />
        </staticContent>
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="4294967295" maxQueryString="4096" />
            </requestFiltering>
        </security>
        <directoryBrowse enabled="true" />

	</system.webServer>
</configuration>